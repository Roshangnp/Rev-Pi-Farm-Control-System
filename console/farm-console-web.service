# Farm console in a web browser (ttyd), on emerald-server: https://emerald-server.local:7681
# Every browser tab attaches to the same tmux session ("farm") as SSH users, so
# all viewers share one console; closing the tab leaves it running.
#
# Install (Ubuntu): sudo apt install ttyd
#   sudo systemctl disable --now ttyd     # the package's own login-shell service on 127.0.0.1:7681
#   sudo mkdir -p /etc/farm-console-web
#   self-signed cert (browsers warn once):
#     sudo openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=emerald-server.local" \
#       -addext "subjectAltName=DNS:emerald-server.local,IP:192.168.1.194" \
#       -keyout /etc/farm-console-web/key.pem -out /etc/farm-console-web/cert.pem
#     sudo chown root:emerald /etc/farm-console-web/key.pem && sudo chmod 640 /etc/farm-console-web/key.pem
#   sudo cp console/farm-console-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now farm-console-web
# NO LOGIN (for now): anyone who can reach port 7681 can switch pumps and valves.
# To add one back: put TTYD_CREDENTIAL=<user>:<password> in /etc/farm-console-web/env
# (chmod 600), add EnvironmentFile=/etc/farm-console-web/env and -c ${TTYD_CREDENTIAL}.
# -O refuses websocket connections from other sites' pages (a page open in a
# browser on the LAN can't type into the console).
[Unit]
Description=Farm console in the browser (ttyd, https port 7681)
After=network-online.target
Wants=network-online.target

[Service]
User=emerald
Environment=LANG=C.UTF-8
ExecStart=/usr/bin/ttyd -p 7681 -S -C /etc/farm-console-web/cert.pem -K /etc/farm-console-web/key.pem \
    -O -t titleFixed=Farm-console \
    /usr/bin/tmux -u new -A -s farm /home/emerald/tools/Rev-Pi-Farm-Control-System/build/ro_console
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
