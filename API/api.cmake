# farm (libfarm.a): all of API/ for this machine. Machine specific: the HAL,
# local, remote and WiseConn devices, device_server, this machine's config
# (src/config/config_<DEVICE_CONFIG>.cpp) and the WiseConn bindings shared by
# every config (src/config/wiseconn_farm_devices.cpp). Programs include
# API/include (devices.h, config.h); API/src is public too, for the remote_*
# headers the console includes.
set(api_dir ${CMAKE_CURRENT_LIST_DIR})
set(config_dir ${api_dir}/src/config)
file(GLOB config_files RELATIVE ${config_dir} ${config_dir}/config_*.cpp)
string(REPLACE "config_" "" available_configs "${config_files}")
string(REPLACE ".cpp" "" available_configs "${available_configs}")
set_property(CACHE DEVICE_CONFIG PROPERTY STRINGS ${available_configs})

set(config_file ${config_dir}/config_${DEVICE_CONFIG}.cpp)
if(DEVICE_CONFIG STREQUAL "" OR NOT EXISTS ${config_file})
    message(FATAL_ERROR "Set -DDEVICE_CONFIG=<name>, one of: ${available_configs}")
endif()
message(STATUS "Device config: ${DEVICE_CONFIG}")

file(GLOB_RECURSE api_sources CONFIGURE_DEPENDS ${api_dir}/src/*.cpp)
list(FILTER api_sources EXCLUDE REGEX "/API/src/config/")
add_library(farm STATIC ${api_sources} ${config_file} ${config_dir}/wiseconn_farm_devices.cpp)
target_include_directories(farm PUBLIC ${api_dir}/include ${api_dir}/src)
target_link_libraries(farm PUBLIC comms Threads::Threads)

# WiseConn keys: wiseconn_keys.txt (repo root, git-ignored: API key, farm, zone and
# measure ids) built in as text, parsed by wiseconn_farm_devices.cpp at startup.
# Only farm sees it. Missing: the WiseConn devices are off. Editing it re-runs cmake.
set(wiseconn_file ${CMAKE_SOURCE_DIR}/wiseconn_keys.txt)
set(WISECONN_KEYS_TEXT "")
if(EXISTS ${wiseconn_file})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${wiseconn_file})
    file(READ ${wiseconn_file} WISECONN_KEYS_TEXT)
else()
    message(WARNING "No ${wiseconn_file}: WiseConn devices are off")
endif()
string(REPLACE "\\" "\\\\" WISECONN_KEYS_TEXT "${WISECONN_KEYS_TEXT}")
string(REPLACE "\"" "\\\"" WISECONN_KEYS_TEXT "${WISECONN_KEYS_TEXT}")
string(REPLACE "\r" "" WISECONN_KEYS_TEXT "${WISECONN_KEYS_TEXT}")
string(REPLACE "\n" "\\n\"\n    \"" WISECONN_KEYS_TEXT "${WISECONN_KEYS_TEXT}")
set(wiseconn_generated_dir ${CMAKE_BINARY_DIR}/generated/wiseconn)
file(CONFIGURE OUTPUT ${wiseconn_generated_dir}/wiseconn_keys_text.h
     CONTENT "#pragma once\n// Generated by CMake from wiseconn_keys.txt, do not edit or commit\ninline constexpr char WISECONN_KEYS_TEXT[] =\n    \"@WISECONN_KEYS_TEXT@\";\n"
     @ONLY)
target_include_directories(farm PRIVATE ${wiseconn_generated_dir})
